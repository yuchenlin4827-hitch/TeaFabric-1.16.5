          "ping",
          "r",
          "realname",
          "renamehome",
          "rules",
          "seen",
          "sethome",
          "sethome.multiple",
          "sethome.multiple.default",
          "signs.use.disposal",
          "signs.use.info",
          "signs.use.warp",
          "spawn",
          "suicide",
          "tpa",
          "tpaccept",
          "tpacancel",
          "tpahere",
